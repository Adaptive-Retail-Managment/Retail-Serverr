  reviewedRecommendations   Recommendation[]
  approvedPriceOverrides    BranchPriceOverride[]
  auditEvents               AuditEvent[]
  stockMovements            StockMovement[]
  reconciliationEvents      ReconciliationEvent[]

  @@unique([businessId, userId])
  @@unique([businessId, id])
  @@index([userId, status])
  @@index([businessId, roleId])
}

