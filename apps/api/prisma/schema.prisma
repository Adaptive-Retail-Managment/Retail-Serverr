// ---------------------------------------------------------------------------
// shared infrastructure
// ---------------------------------------------------------------------------

model OutboxEvent {
  id            String       @id @default(uuid(7)) @db.Uuid
  businessId    String?      @db.Uuid
  aggregateType String       @db.VarChar(64)
  aggregateId   String       @db.Uuid
  eventType     String       @db.VarChar(128)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @db.Timestamptz(6)
  lockedAt      DateTime?    @db.Timestamptz(6)
  lockedBy      String?      @db.VarChar(128)
  lastError     String?
  correlationId String?      @db.Uuid
  occurredAt    DateTime     @default(now()) @db.Timestamptz(6)
  processedAt   DateTime?    @db.Timestamptz(6)
  business      Business?    @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([businessId, id])
  @@index([status, availableAt])
  @@index([businessId, eventType, occurredAt])
}

model IdempotencyRecord {
  id             String           @id @default(uuid(7)) @db.Uuid
  businessId     String?          @db.Uuid
  scope          IdempotencyScope
  key            String           @db.VarChar(256)
  requestHash    String           @db.VarChar(64)
  responseStatus Int
  responseBody   Json
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  expiresAt      DateTime         @db.Timestamptz(6)
  business       Business?        @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([businessId, scope, key])
  @@index([scope, key])
  @@index([expiresAt])
}

model User {
  id                      String                   @id @default(uuid(7)) @db.Uuid
  email                   String                   @unique @db.VarChar(254)
  phone                   String?                  @unique @db.VarChar(32)
  fullName                String                   @db.VarChar(200)
  status                  UserStatus               @default(ACTIVE)
  emailVerifiedAt         DateTime?                @db.Timestamptz(6)
  lastLoginAt             DateTime?                @db.Timestamptz(6)
  createdAt               DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @db.Timestamptz(6)
  deactivatedAt           DateTime?                @db.Timestamptz(6)
  credential              UserCredential?
  sessions                UserSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  memberships             Membership[]
  employees               Employee[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  devices                 Device[]
  supportCasesOpened      SupportCase[]            @relation("SupportCaseOpener")
  supportCasesAssigned    SupportCase[]            @relation("SupportCaseAssignee")
  supportGrantsReceived   SupportAccessGrant[]     @relation("SupportGrantRecipient")
  supportGrantsGranted    SupportAccessGrant[]     @relation("SupportGrantGrantor")

  @@index([status])
}

model UserCredential {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @unique @db.Uuid
  passwordHash  String
  algorithm     String   @default("argon2id") @db.VarChar(32)
  pepperVersion Int      @default(1)
  changedAt     DateTime @default(now()) @db.Timestamptz(6)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSession {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @db.Uuid
  familyId    String    @db.Uuid
  refreshHash String    @unique @db.VarChar(128)
  ipAddress   String?   @db.VarChar(45)
  userAgent   String?   @db.VarChar(512)
  expiresAt   DateTime  @db.Timestamptz(6)
  revokedAt   DateTime? @db.Timestamptz(6)
  lastUsedAt  DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(128)
  expiresAt  DateTime  @db.Timestamptz(6)
  consumedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(128)
  expiresAt  DateTime  @db.Timestamptz(6)
  consumedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

