model Membership {
  id                        String                       @id @default(uuid(7)) @db.Uuid
  businessId                String                       @db.Uuid
  userId                    String                       @db.Uuid
  roleId                    String                       @db.Uuid
  roleBusinessId            String?                      @db.Uuid
  status                    MembershipStatus             @default(INVITED)
  isOwner                   Boolean                      @default(false)
  authorizationVersion      Int                          @default(1)
  joinedAt                  DateTime?                    @db.Timestamptz(6)
  deactivatedAt             DateTime?                    @db.Timestamptz(6)
  createdAt                 DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                     @updatedAt @db.Timestamptz(6)
  business                  Business                     @relation("BusinessMemberships", fields: [businessId], references: [id], onDelete: Restrict)
  ownedBusiness             Business?                    @relation("BusinessOwner")
  user                      User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  role                      Role                         @relation("MembershipRole", fields: [roleId], references: [id], onDelete: Restrict)
  scopedRole                Role?                        @relation("MembershipScopedRole", fields: [roleBusinessId, roleId], references: [businessId, id], onDelete: Restrict)
  branchAssignments         MembershipBranchAssignment[]
  sentInvitations           Invitation[]                 @relation("InvitationInviter")
  shifts                    CashierShift[]
  sales                     Sale[]
  reconciliationAssignments ReconciliationException[]    @relation("ReconciliationAssignee")
