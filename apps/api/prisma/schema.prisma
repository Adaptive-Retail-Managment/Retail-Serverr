model ForecastModel {
  id          String              @id @default(uuid(7)) @db.Uuid
  name        String              @db.VarChar(80)
  version     String              @db.VarChar(40)
  status      ForecastModelStatus @default(ACTIVE)
  description String?
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  retiredAt   DateTime?           @db.Timestamptz(6)
  runs        ForecastRun[]
  metrics     ModelMetric[]

  @@unique([name, version])
  @@index([status])
}

model ForecastRun {
  id              String            @id @default(uuid(7)) @db.Uuid
  businessId      String            @db.Uuid
  branchId        String?           @db.Uuid
  modelId         String            @db.Uuid
  scope           ForecastScope     @default(PRODUCT)
  status          ForecastRunStatus @default(QUEUED)
  horizonDays     Int
  inputsSnapshot  Json
  confidence      String?           @db.VarChar(20)
  explanation     String?
  generatedAt     DateTime?         @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  failureReason   String?           @db.VarChar(500)
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch          Branch?           @relation(fields: [businessId, branchId], references: [businessId, id], onDelete: Restrict)
  model           ForecastModel     @relation(fields: [modelId], references: [id], onDelete: Restrict)
  points          ForecastPoint[]
  recommendations Recommendation[]
  modelMetrics    ModelMetric[]

  @@unique([businessId, id])
  @@index([businessId, status, createdAt])
  @@index([businessId, branchId, scope])
}

model ForecastPoint {
  id            String      @id @default(uuid(7)) @db.Uuid
  forecastRunId String      @db.Uuid
  pointDate     DateTime    @db.Date
  expected      Decimal     @db.Decimal(18, 3)
  lowerBound    Decimal     @db.Decimal(18, 3)
  upperBound    Decimal     @db.Decimal(18, 3)
  forecastRun   ForecastRun @relation(fields: [forecastRunId], references: [id], onDelete: Restrict)

  @@unique([forecastRunId, pointDate])
}

model Recommendation {
  id                     String               @id @default(uuid(7)) @db.Uuid
  businessId             String               @db.Uuid
  branchId               String?              @db.Uuid
  forecastRunId          String?              @db.Uuid
  variantId              String?              @db.Uuid
  type                   RecommendationType
  status                 RecommendationStatus @default(PROPOSED)
  title                  String               @db.VarChar(200)
  rationale              String
  proposedAction         Json
  confidence             String?              @db.VarChar(20)
  reviewedByMembershipId String?              @db.Uuid
  reviewedAt             DateTime?            @db.Timestamptz(6)
  decisionNote           String?
  createdAt              DateTime             @default(now()) @db.Timestamptz(6)
  expiresAt              DateTime?            @db.Timestamptz(6)
  business               Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch                 Branch?              @relation(fields: [businessId, branchId], references: [businessId, id], onDelete: Restrict)
  forecastRun            ForecastRun?         @relation(fields: [businessId, forecastRunId], references: [businessId, id], onDelete: Restrict)
  variant                ProductVariant?      @relation(fields: [businessId, variantId], references: [businessId, id], onDelete: Restrict)
  reviewedByMembership   Membership?          @relation(fields: [businessId, reviewedByMembershipId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@index([businessId, status, createdAt])
  @@index([businessId, variantId])
}

model FeatureSnapshot {
  id           String          @id @default(uuid(7)) @db.Uuid
  businessId   String          @db.Uuid
  variantId    String?         @db.Uuid
  snapshotDate DateTime        @db.Date
  features     Json
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  business     Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  variant      ProductVariant? @relation(fields: [businessId, variantId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@index([businessId, snapshotDate])
}

model ModelMetric {
  id            String        @id @default(uuid(7)) @db.Uuid
  businessId    String        @db.Uuid
  modelId       String        @db.Uuid
  forecastRunId String?       @db.Uuid
  metricName    String        @db.VarChar(80)
  metricValue   Decimal       @db.Decimal(18, 6)
  recordedAt    DateTime      @default(now()) @db.Timestamptz(6)
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  model         ForecastModel @relation(fields: [modelId], references: [id], onDelete: Restrict)
  forecastRun   ForecastRun?  @relation(fields: [businessId, forecastRunId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@index([businessId, modelId, recordedAt])
}

