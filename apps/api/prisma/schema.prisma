  locale          String              @default("en") @db.VarChar(10)
  version         Int                 @default(1)
  subjectTemplate String?             @db.VarChar(300)
  bodyTemplate    String
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now()) @db.Timestamptz(6)
  business        Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  notifications   Notification[]

  @@unique([businessId, code, channel, locale, version])
  @@unique([businessId, id])
  @@index([businessId, code, isActive])
}

model Notification {
  id              String                   @id @default(uuid(7)) @db.Uuid
  businessId      String                   @db.Uuid
  branchId        String?                  @db.Uuid
  recipientUserId String                   @db.Uuid
  templateId      String?                  @db.Uuid
  channel         NotificationChannel      @default(IN_APP)
  severity        NotificationSeverity     @default(INFO)
  status          NotificationStatus       @default(UNREAD)
  category        String                   @db.VarChar(60)
  title           String                   @db.VarChar(300)
  body            String
  entityType      String?                  @db.VarChar(60)
  entityId        String?                  @db.Uuid
  dedupeKey       String?                  @db.VarChar(120)
  readAt          DateTime?                @db.Timestamptz(6)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(6)
  expiresAt       DateTime?                @db.Timestamptz(6)
  business        Business                 @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch          Branch?                  @relation(fields: [businessId, branchId], references: [businessId, id], onDelete: Restrict)
  recipient       User                     @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  template        NotificationTemplate?    @relation(fields: [businessId, templateId], references: [businessId, id], onDelete: Restrict)
  deliveries      NotificationDelivery[]
  escalations     NotificationEscalation[]

  @@unique([businessId, dedupeKey])
  @@unique([businessId, id])
  @@index([recipientUserId, status, createdAt])
  @@index([businessId, category, createdAt])
}

model NotificationDelivery {
  id                String              @id @default(uuid(7)) @db.Uuid
  businessId        String              @db.Uuid
  notificationId    String              @db.Uuid
  channel           NotificationChannel
  status            DeliveryStatus      @default(PENDING)
  attemptCount      Int                 @default(0)
  lastAttemptAt     DateTime?           @db.Timestamptz(6)
  sentAt            DateTime?           @db.Timestamptz(6)
  providerMessageId String?             @db.VarChar(200)
  lastError         String?             @db.VarChar(500)
  notification      Notification        @relation(fields: [businessId, notificationId], references: [businessId, id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@unique([businessId, id])
  @@index([businessId, status, lastAttemptAt])
}

model NotificationPreference {
  id        String              @id @default(uuid(7)) @db.Uuid
  userId    String              @db.Uuid
  channel   NotificationChannel
  category  String              @db.VarChar(60)
  isEnabled Boolean             @default(true)
  updatedAt DateTime            @updatedAt @db.Timestamptz(6)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, category])
}

model NotificationEscalation {
  id             String         @id @default(uuid(7)) @db.Uuid
  businessId     String         @db.Uuid
  notificationId String         @db.Uuid
  level          Int            @default(1)
  status         FollowUpStatus @default(OPEN)
  escalatedAt    DateTime       @default(now()) @db.Timestamptz(6)
