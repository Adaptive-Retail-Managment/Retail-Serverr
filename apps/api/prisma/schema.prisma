  sales                    Sale[]
  returnRequests           ReturnRequest[]
  refunds                  Refund[]
  exchanges                Exchange[]
  collectionFollowUps      CollectionFollowUp[]
  notificationTemplates    NotificationTemplate[]
  notifications            Notification[]
